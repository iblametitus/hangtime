# Copy to .env and fill in. Never commit the real .env (it's gitignored).

NEBIUS_API_KEY=
TAVILY_API_KEY=

# Confirmed with `uv run python scripts/check_models.py` (2026-10-21): all three
# pass JSON-schema calls. MODEL_VISION accepts at most 8 images per prompt.
# Alternative REASON model that also works: nvidia/nemotron-3-super-120b-a12b
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
MODEL_REASON=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_AUDIO=

# Review pages under /admin. Never enable on the public deployment.
ENABLE_ADMIN=false
